# Copy this file to `terraform.tfvars` and fill in real values.
# `terraform.tfvars` is gitignored. NEVER commit secrets.

aws_region   = "us-east-1"
project_name = "mlops-framework"
env          = "prod"
owner        = "mlops"

# VPC / networking
vpc_cidr = "10.0.0.0/16"
# Restrict SSH to your own IP, e.g. "203.0.113.7/32".
admin_cidr = "0.0.0.0/0"

# EC2
ec2_instance_type = "t3.micro"
ec2_ebs_size_gb   = 20

# Paste the public half of `ssh-keygen -t ed25519 -f ~/.ssh/mlops-framework`.
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# RDS
db_username = "mlops_admin"
# 8+ chars. Pass via TF_VAR_db_password in CI, or here locally.
# db_password        = "REPLACE_ME"
db_name                 = "mlops_framework"
db_instance_class       = "db.t3.micro"
db_allocated_storage_gb = 20

# Auto-deploy stack on first boot. When true (default), the EC2 user
# data script pulls the public Apache Airflow + MLflow images from
# Docker Hub / GHCR, runs `docker compose up -d`, migrates the
# Airflow DB, and creates the admin user. Set false to start the
# instance without containers (debug boot problems first).
auto_deploy = true
