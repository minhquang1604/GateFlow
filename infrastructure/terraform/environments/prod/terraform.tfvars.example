# Copy this file to `terraform.tfvars` and fill in real values.
# `terraform.tfvars` is gitignored. NEVER commit secrets.

aws_region   = "us-east-1"
project_name = "mlops-framework"
env          = "prod"
owner        = "mlops"

# VPC / networking
vpc_cidr = "10.0.0.0/16"
# Restrict SSH to your own IP, e.g. "203.0.113.7/32".
admin_cidr = "0.0.0.0/0"

# EC2 / ECS container instances
ec2_instance_type = "t3.micro"
# 2 instances (default) fit the full stack across ~2 GB combined RAM.
# Set to 1 to stay strictly inside the 750 EC2 instance-hour/month
# Free Tier pool at the cost of some services being unschedulable —
# see the `instance_count` description in variables.tf.
instance_count  = 2
# The ECS-optimized AL2023 AMI's root snapshot requires >= 30 GB;
# a smaller value fails at apply time.
ec2_ebs_size_gb = 30

# Paste the public half of `ssh-keygen -t ed25519 -f ~/.ssh/mlops-framework`.
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# RDS
db_username = "mlops_admin"
# 8+ chars. Pass via TF_VAR_db_password in CI, or here locally.
# db_password        = "REPLACE_ME"
db_name                 = "mlops_framework"
db_instance_class       = "db.t3.micro"
db_allocated_storage_gb = 20

# ECS image tags. Terraform only creates the ECR repositories and
# points ECS services at these tags — it never builds or pushes
# images. .github/workflows/deploy.yml builds
# infrastructure/mlflow/Dockerfile and infrastructure/airflow/Dockerfile
# and pushes `:latest` + `:<git-sha>` on every push to main. Leave
# "latest" unless you want to pin a specific tag.
mlflow_image_tag = "latest"
app_image_tag    = "latest"
