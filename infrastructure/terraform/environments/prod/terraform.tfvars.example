# Copy this file to `terraform.tfvars` and fill in real values.
# `terraform.tfvars` is gitignored. NEVER commit secrets.

aws_region   = "ap-southeast-1"
project_name = "mlops-framework"
env          = "prod"
owner        = "mlops"

# VPC / networking
vpc_cidr = "10.0.0.0/16"
# Restrict SSH to your own IP, e.g. "203.0.113.7/32".
admin_cidr = "0.0.0.0/0"

# EC2 / ECS container instances
# m7i-flex.large (not Free-Tier, ~$0.09576/hr ~= $70/mo). Smaller
# types were tried first and didn't hold the stack — see
# ec2_instance_type's description in variables.tf for the history.
# t3.medium (~$30/mo) also fits everything if cost matters more
# than headroom.
ec2_instance_type = "m7i-flex.large"
# The full stack (~2570 MiB reserved) fits on one m7i-flex.large.
# Raise to 2 if you want a spare host to survive an instance
# becoming wedged — that happened twice during bring-up.
instance_count = 1
# The ECS-optimized AL2023 AMI's root snapshot requires >= 30 GB;
# a smaller value fails at apply time.
ec2_ebs_size_gb = 30

# Paste the public half of `ssh-keygen -t ed25519 -f ~/.ssh/mlops-framework`.
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# RDS
db_username = "mlops_admin"
# 8+ chars. Pass via TF_VAR_db_password in CI, or here locally.
# db_password        = "REPLACE_ME"
db_name                 = "mlops_framework"
db_instance_class       = "db.t3.micro"
# Must exist in aws_region — versions differ by region. 15.7 is not
# offered in ap-southeast-1; 15.13 is.
db_engine_version       = "15.13"
db_allocated_storage_gb = 20

# ECS image tags. Terraform only creates the ECR repositories and
# points ECS services at these tags — it never builds or pushes
# images. .github/workflows/deploy.yml builds
# infrastructure/mlflow/Dockerfile, infrastructure/airflow/Dockerfile,
# and infrastructure/app/Dockerfile, and pushes `:latest` +
# `:<git-sha>` on every push to main. Leave "latest" unless you want
# to pin a specific tag.
mlflow_image_tag  = "latest"
airflow_image_tag = "latest"
app_image_tag     = "latest"
