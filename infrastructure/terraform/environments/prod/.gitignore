# Local Terraform state and downloaded providers
.terraform/
.terraform.lock.hcl

# State files (we use local state; never commit)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files (may contain secrets)
*.tfvars
!terraform.tfvars.example

# Plans and crash logs
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# Override files (per Terraform docs)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
