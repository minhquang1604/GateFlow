#!/usr/bin/env bash
# EC2 bootstrap script — executed once on first boot.
#
# Template variables (filled in by Terraform):
#   ssm_prefix              — e.g. "/mlops-framework/prod"
#   aws_region              — e.g. "us-east-1"
#   db_host                 — RDS endpoint
#   db_port                 — RDS port (5432)
#   db_username             — RDS master username
#   db_name                 — initial DB created by RDS (mlops_framework)
#   mlflow_artifacts_bucket — S3 bucket for MLflow
#   ecr_registry            — registry hostname (e.g. "123.dkr.ecr.us-east-1.amazonaws.com")
#   ecr_mlflow              — ECR URI for mlflow image
#   ecr_app                 — ECR URI for app/serving image
#
# What this script does:
#   1. Installs Docker, docker-compose-plugin, AWS CLI v2, psql client.
#   2. Fetches the four SSM SecureString parameters and writes
#      /opt/mlops/.env (chmod 600) — this is what docker-compose.aws.yml
#      reads via `env_file:`.
#   3. Creates the `mlflow` and `airflow` databases on the RDS instance.
#   4. Renders a starting /opt/mlops/docker-compose.aws.yml that points
#      at the ECR URIs and the /opt/mlops/.env file.
#
# It does NOT start the full stack — that is left to the operator
# (or a future GitHub Actions deploy step) so that boot problems
# can be debugged in isolation.

set -euo pipefail

LOG=/var/log/mlops-bootstrap.log
exec > >(tee -a "$LOG") 2>&1

echo "[bootstrap] starting at $(date -u +%FT%TZ)"

# ---------------------------------------------------------------------- #
# 1. Base packages                                                        #
# ---------------------------------------------------------------------- #
dnf update -y
dnf install -y \
    docker \
    postgresql15 \
    jq \
    tar \
    gzip

systemctl enable --now docker
usermod -aG docker ec2-user

# docker compose plugin (Amazon Linux 2023 ships compose v2 in the
# `docker` package, but make sure the plugin path exists).
docker compose version || {
    mkdir -p /usr/local/lib/docker/cli-plugins
    curl -fsSL "https://github.com/docker/compose/releases/download/v2.27.0/docker-compose-linux-x86_64" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
}

# AWS CLI v2 (always pull the latest minor).
if ! command -v aws >/dev/null 2>&1; then
    dnf install -y unzip
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
    unzip -q /tmp/awscliv2.zip -d /tmp
    /tmp/aws/install
    rm -rf /tmp/awscliv2.zip /tmp/aws
fi

# ---------------------------------------------------------------------- #
# 2. Helper for fetching SSM SecureString parameters.                    #
# ---------------------------------------------------------------------- #
# Defined here so it can be used by both the .env writer and the psql
# bootstrap below.
ssm_get() {
    aws ssm get-parameter --name "$1" --with-decryption \
        --region "${aws_region}" --query 'Parameter.Value' --output text
}

mkdir -p /opt/mlops
# .env values are written with one `aws ssm get-parameter` call per
# secret so docker-compose reads them as plain KEY=VALUE pairs.
cat > /opt/mlops/.env <<EOF
# Generated by Terraform user data — do not edit by hand.
# Secrets below are inlined from SSM Parameter Store under ${ssm_prefix}/

AWS_REGION=${aws_region}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_USERNAME=${db_username}
DB_NAME=${db_name}
MLFLOW_ARTIFACTS_BUCKET=${mlflow_artifacts_bucket}
ECR_REGISTRY=${ecr_registry}
ECR_MLFLOW_REPO=${ecr_mlflow}
ECR_APP_REPO=${ecr_app}
AIRFLOW_ADMIN_USERNAME=admin
EOF
# Append the secrets after the static block. We deliberately write
# them with `printf` (not heredoc) so the SSM value is inlined as-is.
ssm_get() {
    aws ssm get-parameter --name "$1" --with-decryption \
        --region "${aws_region}" --query 'Parameter.Value' --output text
}
{
    printf 'AIRFLOW_FERNET_KEY=%s\n'             "$(ssm_get "${ssm_prefix}/airflow/fernet-key")"
    printf 'AIRFLOW_WEBSERVER_SECRET_KEY=%s\n'   "$(ssm_get "${ssm_prefix}/airflow/web-secret")"
    printf 'AIRFLOW_ADMIN_PASSWORD=%s\n'         "$(ssm_get "${ssm_prefix}/airflow/admin-password")"
    printf 'DB_PASSWORD=%s\n'                    "$(ssm_get "${ssm_prefix}/db/password")"
} >> /opt/mlops/.env
chmod 600 /opt/mlops/.env
chown -R ec2-user:ec2-user /opt/mlops

# ---------------------------------------------------------------------- #
# 3. Initialise the additional databases on the RDS instance.            #
#    RDS only creates `db_name` (mlops_framework); the framework needs  #
#    `mlflow` and `airflow` as well.                                    #
# ---------------------------------------------------------------------- #
echo "[bootstrap] creating additional databases (mlflow, airflow) on RDS"
PGPASSWORD=$(ssm_get "${ssm_prefix}/db/password") \
    psql -h "${db_host}" -p "${db_port}" -U "${db_username}" -d postgres -c \
    "SELECT 'CREATE DATABASE mlflow' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'mlflow')\\gexec" || true
PGPASSWORD=$(ssm_get "${ssm_prefix}/db/password") \
    psql -h "${db_host}" -p "${db_port}" -U "${db_username}" -d postgres -c \
    "SELECT 'CREATE DATABASE airflow' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'airflow')\\gexec" || true

# ---------------------------------------------------------------------- #
# 4. Render a minimal docker-compose.aws.yml so the operator can        #
#    docker compose pull / up without writing YAML by hand.            #
#    The image references use $${...} so Bash hands the placeholder    #
#    through to docker compose (which expands it from .env).           #
# ---------------------------------------------------------------------- #
cat > /opt/mlops/docker-compose.aws.yml <<'COMPOSE'
# Minimal compose file rendered by Terraform. Edit the image tags
# (or the env_file path) freely; do not commit secrets here — they
# are sourced from /opt/mlops/.env (chmod 600).
services:
  mlflow:
    image: ghcr.io/mlflow/mlflow:v2.16.0
    restart: unless-stopped
    env_file: .env
    ports:
      - "5000:5000"
  airflow-webserver:
    image: apache/airflow:2.10.4-python3.11
    restart: unless-stopped
    user: airflow
    env_file: .env
    command: webserver
    ports:
      - "8080:8080"
    volumes:
      - ./dags:/opt/airflow/dags:ro
      - airflow_logs:/opt/airflow/logs
  airflow-scheduler:
    image: apache/airflow:2.10.4-python3.11
    restart: unless-stopped
    user: airflow
    env_file: .env
    command: scheduler
    volumes:
      - ./dags:/opt/airflow/dags:ro
      - airflow_logs:/opt/airflow/logs
  app:
    image: $${ECR_APP_REPO}:latest
    restart: unless-stopped
    env_file: .env
    ports:
      - "8000:8000"
  serving:
    image: $${ECR_APP_REPO}:latest
    restart: unless-stopped
    env_file: .env
    command: python -m mlops_framework.serving.run --host 0.0.0.0 --port 8001
    ports:
      - "8001:8001"
volumes:
  airflow_logs: {}
COMPOSE
chown -R ec2-user:ec2-user /opt/mlops

# ---------------------------------------------------------------------- #
# 5. Done — print next steps for the operator.                           #
# ---------------------------------------------------------------------- #
printf '\n============================================================\n'
printf 'MLOps bootstrap complete.\n\n'
printf 'AWS region        : %s\n' "${aws_region}"
printf 'RDS endpoint      : %s\n' "${db_host}:${db_port}"
printf 'ECR registry      : %s\n' "${ecr_registry}"
printf 'ECR mlflow image  : %s\n' "${ecr_mlflow}"
printf 'ECR app image     : %s\n' "${ecr_app}"
printf '\nNext steps (run as ec2-user):\n'
printf '    sudo -iu ec2-user\n'
printf '    cd /opt/mlops\n'
printf '    aws ecr get-login-password --region %s \\\n' "${aws_region}"
printf '        | docker login --username AWS --password-stdin "<ECR_REGISTRY from /opt/mlops/.env>"\n'
printf '    # Push custom images to ECR from your laptop:\n'
printf '    #   docker build -f infrastructure/mlflow/Dockerfile -t mlops-framework/mlflow:aws-1.0.0 .\n'
printf '    #   docker push %s:aws-1.0.0\n' "${ecr_mlflow}"
printf '    docker compose -f docker-compose.aws.yml pull\n'
printf '    docker compose -f docker-compose.aws.yml up -d\n'
printf '    # One-time Airflow DB migrate + admin user (uses the password from .env):\n'
printf '    docker compose -f docker-compose.aws.yml run --rm airflow-webserver \\\n'
printf '        bash -c "airflow db migrate && set -a && . /opt/mlops/.env && set +a && airflow users create --username admin --password \$AIRFLOW_ADMIN_PASSWORD --firstname Admin --lastname User --role Admin --email admin@example.com"\n'
printf '============================================================\n'

# ---------------------------------------------------------------------- #
# 6. Auto-deploy the stack (only if AUTO_DEPLOY=true).                   #
#    Pulls the public Apache Airflow image, logs in to ECR for custom  #
#    images (mlflow/app), then runs `docker compose up -d`.            #
#    Set AUTO_DEPLOY=false in Terraform variables to disable.          #
# ---------------------------------------------------------------------- #
if [ "${auto_deploy}" = "true" ]; then
    echo "[bootstrap] AUTO_DEPLOY=true — starting full stack"
    cd /opt/mlops

    # ECR login so any custom mlflow/app image already pushed to ECR can
    # be pulled. If you only run the public Airflow image, this is a no-op.
    aws ecr get-login-password --region "${aws_region}" \
        | docker login --username AWS --password-stdin "${ecr_registry}" || true

    # Pull images referenced by docker-compose.aws.yml
    docker compose -f docker-compose.aws.yml pull || true

    # Start the full stack
    docker compose -f docker-compose.aws.yml up -d

    # One-time Airflow: migrate metadata DB and create the admin user.
    # Both commands read /opt/mlops/.env for AIRFLOW_ADMIN_PASSWORD.
    docker compose -f docker-compose.aws.yml run --rm airflow-webserver \
        bash -c "airflow db migrate && \
                 airflow users create \
                 --username admin \
                 --password \"\$AIRFLOW_ADMIN_PASSWORD\" \
                 --firstname Admin --lastname User \
                 --role Admin \
                 --email admin@example.com" || true

    # Restart webserver so the new admin user is loaded.
    docker compose -f docker-compose.aws.yml restart airflow-webserver airflow-scheduler || true

    echo "[bootstrap] AUTO_DEPLOY complete"
else
    echo "[bootstrap] AUTO_DEPLOY=false — operator must run docker compose up manually"
fi
