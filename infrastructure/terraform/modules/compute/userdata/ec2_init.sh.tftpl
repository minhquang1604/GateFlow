#!/usr/bin/env bash
# ECS container instance bootstrap — executed once on first boot by the
# ECS-optimized Amazon Linux 2023 AMI.
#
# Template variables (filled in by Terraform):
#   ecs_cluster_name — name of the ECS cluster this instance registers with.
#
# The ECS-optimized AMI ships the ECS agent and Docker preinstalled;
# all this script has to do is point the agent at the right cluster.
# No image pulls, no docker compose, no secret plumbing — ECS task
# definitions own image references, and the `secrets` block resolves
# SSM SecureString parameters directly into each container's
# environment at launch, so nothing needs to be written to disk here.

set -euo pipefail

LOG=/var/log/mlops-bootstrap.log
exec > >(tee -a "$LOG") 2>&1

echo "[bootstrap] starting at $(date -u +%FT%TZ)"

cat >> /etc/ecs/ecs.config <<CONFIG
ECS_CLUSTER=${ecs_cluster_name}
ECS_ENABLE_CONTAINER_METADATA=true
CONFIG

# Do NOT run a blocking `systemctl restart ecs` here.
#
# The AMI's ecs.service is declared `After=cloud-final.service`, which
# is precisely how it guarantees the agent starts only once this
# script has written ECS_CLUSTER. Asking systemd to start it *from
# inside* cloud-final deadlocks: the restart job can't run until
# cloud-final finishes, and cloud-final can't finish because it's
# blocked on the restart job. The instance then sits forever with
#
#   cloud-final.service  start running
#   ecs.service          start waiting
#
# and the agent never comes up at all, so the cluster reports zero
# registered container instances and every service fails to place a
# task with "No Container Instances were found in your capacity
# provider".
#
# `--no-block` queues the job and returns immediately, which is safe
# in both directions: if the AMI ever drops the After= ordering and
# the agent has already read a cluster-less config, this restarts it;
# if the ordering holds, the queued job is a no-op alongside the one
# systemd already scheduled.
systemctl enable ecs
systemctl restart --no-block ecs

# Nothing polls the agent's introspection endpoint here on purpose —
# it cannot answer until this script exits (see above). Check
# registration from outside instead:
#   aws ecs list-container-instances --cluster ${ecs_cluster_name}
echo "[bootstrap] ECS agent start queued for cluster ${ecs_cluster_name}"
