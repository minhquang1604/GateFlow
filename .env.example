# Database configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mlops_framework

# Database pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# MLflow tracking server (optional — leave blank to use a local mlflow setup)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mlops-framework
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Airflow orchestrator (optional — leave blank to use LocalDockerOrchestrator)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# FastAPI ServingBridge URL (used by the HTTP event publisher).
SERVING_BRIDGE_URL=http://localhost:8001

# Application settings
APP_NAME=mlops-framework
APP_VERSION=0.1.0

# Development settings
DEBUG=false

# Telegram admin-approval gate (drift/retrain demo — scripts/run_drift_recovery_demo.py)
# Create a bot via @BotFather to get a token, then message it once and call
# https://api.telegram.org/bot<token>/getUpdates to read your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT_SECONDS=3600
